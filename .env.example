# Copy to .env.local and fill in.

# Microsoft sign-in for people connecting their own Azure (optional for local use).
# Create the app registration with scripts/create-entra-app.ps1, then paste its client ID here.
NEXT_PUBLIC_ENTRA_CLIENT_ID=
# "organizations" accepts any work or school account. Use a tenant ID to limit sign-in to one tenant.
NEXT_PUBLIC_ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations

# How the server gets an Azure token:
#   (unset) - Azure CLI sign-in in development, Microsoft sign-in only in production
#   cli     - always allow the host's `az login` session. Never set this on a public deployment.
#   bearer  - only accept tokens from signed-in users
AZURE_AUTH_MODE=
